<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      "Cin efekti": Compose'un AlertDialog/Dialog'u altta standart bir Android
      Dialog penceresi açar ve tema özniteliği olarak windowAnimationStyle'ı
      miras alır — bu yüzden merkezi bir tema değişikliği tüm diyaloglara
      (özel bir tema geçmedikleri sürece) uygulanır.
    -->
    <style name="DialogGenieAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_genie_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_genie_exit</item>
    </style>

    <style name="Theme.Hedefit" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#080A08</item>
        <item name="android:navigationBarColor">#080A08</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowAnimationStyle">@style/DialogGenieAnimation</item>
    </style>
</resources>
